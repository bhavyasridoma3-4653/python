
# University Scholarship Allocation

students = []
eligible_students = []

n = int(input("Enter number of students: "))

for i in range(n):
    print("\nEnter details of Student", i + 1)

    name = input("Enter student name: ")

    m1 = int(input("Enter subject 1 marks: "))
    m2 = int(input("Enter subject 2 marks: "))
    m3 = int(input("Enter subject 3 marks: "))

    attendance = float(input("Enter attendance percentage: "))
    income = float(input("Enter family income: "))

    total = m1 + m2 + m3
    aggregate = total / 3

    # Eligibility checking
    if (aggregate >= 75 and
        m1 >= 60 and m2 >= 60 and m3 >= 60 and
        attendance >= 75 and income <= 250000):

        students.append((name, aggregate, attendance, income))

    else:
        print(name, "is not eligible for scholarship")

# Ranking students
students.sort(key=lambda x: (x[1], x[2]), reverse=True)

print("\n----- SCHOLARSHIP ELIGIBLE STUDENTS -----")

if len(students) == 0:
    print("No eligible students found")

else:
    rank = 1

    for student in students:
        name, marks, attendance, income = student

        print("\nRank:", rank)
        print("Name:", name)
        print("Aggregate Marks:", marks)
        print("Attendance:", attendance)
        print("Family Income:", income)

        rank += 1
